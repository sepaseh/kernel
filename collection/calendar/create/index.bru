meta {
  name: Create Calendar Date
  type: http
  seq: 2
}

post {
  url: {{base_url}}/calendar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "date": "2026-09-15"
  }
}

docs {
  ## Purpose

  Marks one date on the system calendar.

  ## Authentication

  Requires a valid access token with `calendar.update` permission.

  ## Response

  - `200 OK` — Date added successfully with no response body.
  - `400 Bad Request` — The date is missing or malformed.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user cannot update the calendar.
}
