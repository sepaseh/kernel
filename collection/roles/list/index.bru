meta {
  name: List Roles
  type: http
  seq: 1
}

get {
  url: {{base_url}}/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

headers {
  Accept: application/json
}

docs {
  ## Purpose

  Returns all roles.

  ## Authentication

  Requires a valid access token with permission to read roles.

  ## Behavior

  - Each role includes its UUID, name, and an array of permission name values.
  - Roles are access-control configuration.

  ## Response

  - `200 OK` — Roles returned successfully.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user cannot read roles.
}
