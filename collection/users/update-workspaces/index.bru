meta {
  name: Update User Workspaces
  type: http
  seq: 8
}

put {
  url: {{base_url}}/users/{{user_id}}/workspaces
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "workspace_ids": [
      "{{workspace_id}}"
    ]
  }
}

docs {
  ## Purpose

  Replaces the complete workspace assignment of a user.

  ## Authentication

  Requires a valid access token with permission to update user workspaces.

  ## Behavior

  - Every workspace ID must reference an existing workspace.
  - Workspaces omitted from `workspace_ids` are removed from the user.
  - The operation is idempotent.
  - A successful request returns no response body.

  ## Response

  - `200 OK` — User workspaces updated successfully with no response body.
  - `400 Bad Request` — The workspace-ID list is missing or invalid.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user cannot update user workspaces.
  - `404 Not Found` — The user does not exist.
  - `409 Conflict` — The workspace change violates a system constraint.
}
