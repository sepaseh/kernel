meta {
  name: List Workspaces
  type: http
  seq: 3
}

get {
  url: {{base_url}}/workspaces
  body: none
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

headers {
  Accept: application/json
}

docs {
  ## Purpose

  Returns a paginated list of workspaces.

  ## Authentication

  Requires a valid access token with permission to read workspaces.

  ## Behavior

  - Returns all workspaces available to the authenticated user.

  ## Response

  - `200 OK` — Workspaces returned successfully.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user cannot read workspaces.
}
