{
  "name": "kernel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "qs": "^6.15.3"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "build-storybook": "storybook build",
    "bundle:size": "node scripts/check-bundle-size.mjs",
    "dev": "vite --host",
    "build": "node scripts/validate-production-env.mjs && tsc -b && vite build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "knip": "knip",
    "performance": "npm run build && npm run bundle:size",
    "preview": "vite preview",
    "server": "node server/server.cjs",
    "server:test": "node --test server/*.test.cjs",
    "test": "vitest run --project=unit",
    "test:contract": "vitest run --config=vitest.contract.config.ts",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --project=visual-chromium --update-snapshots",
    "test:smoke": "playwright test --config=smoke.config.ts",
    "test:staging": "playwright test --config=staging.config.ts",
    "test:storybook": "vitest run --project=storybook",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "^6.6.1",
    "antd-style": "^4.1.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.0",
    "jalaliday": "^3.1.1",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.3",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/types": "^8.68.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "lighthouse": "^13.4.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "10.5.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
